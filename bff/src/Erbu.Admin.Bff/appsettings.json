{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Auth": {
    "Authority": "http://localhost:5090",
    "Audience": "Erbu.Clients"
  },

  "Secrets": {
    "GeoSearchAdminKey": "REPLACE_FROM_SECRETS"
  },

  "DownstreamHubs": {
    "Notifications": "http://localhost:5085/hubs/secure",
    "Voip": "http://localhost:5085/hubs/voip",
    "Orchestrator": "http://localhost:5082/hubs/orchestrator",
    "Ingestion": "http://localhost:5080/hubs/ingestion",
    "SearchOps": "http://localhost:5080/hubs/search-ops",
    "TripPlanner": "http://localhost:5100/hubs/trip-planner"
  },

  "ReverseProxy": {
    "Routes": {
      "geo-admin-search": {
        "ClusterId": "geocoding-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/admin/geo-search/{**catch-all}" }
      },
      "geo-admin": {
        "ClusterId": "geocoding-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/admin/geo/{**catch-all}" }
      },
      "geo-api": {
        "ClusterId": "geocoding-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/geo/{**catch-all}" }
      },
      "geo-monitor": {
        "ClusterId": "geocoding-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/monitor/{**catch-all}" }
      },
      "api-catch-all": {
        "ClusterId": "edge-gateway",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "edge-gateway": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "geocoding-direct": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5080"
          }
        }
      }
    }
  }
}
