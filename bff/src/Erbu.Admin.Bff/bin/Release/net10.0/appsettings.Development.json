        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/monitor/{**catch-all}" }
      },
      "api-catch-all": {
        "ClusterId": "edge-gateway",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
