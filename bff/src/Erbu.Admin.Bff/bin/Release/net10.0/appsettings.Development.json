{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Auth": {
    "Authority": "http://localhost:5090",
    "Audience": "Erbu.Clients",
    "DevSecret": "dev-secret-erbu-docker-2024"
  },
  "Secrets": {
    "GeoSearchAdminKey": "dev-geo-admin-key"
  },
  "DownstreamHubs": {
    "Notifications": "http://localhost:5085/hubs/secure",
    "Voip": "http://localhost:5085/hubs/voip",
    "Orchestrator": "http://localhost:5082/hubs/orchestrator",
    "Ingestion": "http://localhost:5080/hubs/ingestion",
    "SearchOps": "http://localhost:5080/hubs/search-ops",
    "TripPlanner": "http://localhost:5100/hubs/trip-planner"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-admin-users": {
        "ClusterId": "auth-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/auth/admin/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth/admin" },
          { "PathPrefix": "/api/admin" }
        ]
      },
      "auth-me": {
        "ClusterId": "auth-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/auth/me" },
        "Transforms": [
          { "PathPattern": "/api/auth/me" }
        ]
      },
      "payment-monitor": {
        "ClusterId": "payment-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/ops/payment-monitor/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/ops/payment-monitor" },
          { "PathPrefix": "/api/admin/monitor" }
        ]
      },
      "reputation": {
        "ClusterId": "portfolio-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/ops/reputation/{**catch-all}" },
