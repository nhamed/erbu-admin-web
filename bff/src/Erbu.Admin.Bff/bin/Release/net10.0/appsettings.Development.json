        "Match": { "Path": "/api/admin/riders/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/admin/riders" },
          { "PathPrefix": "/admin/riders" }
        ]
      },
      "rider-admin-root": {
        "ClusterId": "rider-direct",
        "AuthorizationPolicy": "RequireAdmin",
        "Order": 0,
        "Match": { "Path": "/api/admin/riders" },
        "Transforms": [
          { "PathPattern": "/admin/riders" }
        ]
